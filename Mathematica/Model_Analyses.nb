Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PtoB", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["p", "i"], "->", 
     FractionBox[
      RowBox[{
       SubscriptBox["b", "i"], "/", 
       SubscriptBox["\[Mu]", "i"]}], 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         SubscriptBox["b", "j"], "/", 
         SubscriptBox["\[Mu]", "j"]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "SpeciesIndices"}], "}"}]}], "]"}]]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "SpeciesIndices"}], "}"}]}], "]"}]}]], "Input",

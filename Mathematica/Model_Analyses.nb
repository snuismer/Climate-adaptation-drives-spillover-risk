             RowBox[{"1", "-", 
              SubscriptBox["p", "w"]}], "3"]}]}], "}"}]}], "/.", 
        RowBox[{
         SubscriptBox["n", "t"], "->", "Nherd"}]}], "/.", "SimPars"}], ")"}], 
     "<", "1"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["p", "w"], ",", "0.008", ",", ".992"}], "}"}], ",", 

Cell["\<\
Solve for steady state force of infection and seroprevalence by looping over \
parameter combinations:\
\>", "Text",
 CellChangeTimes->{{3.970917102442388*^9, 
  3.970917125714621*^9}},ExpressionUUID->"6a7dc10c-f86e-41f9-b569-\
9bcebd68a3eb"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], ",", 
   RowBox[{
    RowBox[{"StoreMe3", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "0"}], ",", 
      RowBox[{"i", "<", "11"}], ",", 
      RowBox[{"i", "++"}], ",", 
      RowBox[{
       RowBox[{"Camels", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Cam0", "/.", "SimPars"}], ")"}], "+", 
         RowBox[{"40", "*", "i"}]}]}], ";", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "0"}], ",", 
         RowBox[{"j", "<", "11"}], ",", 
         RowBox[{"j", "++"}], ",", 
         RowBox[{
          RowBox[{"RhoRep", "=", 
           RowBox[{"{", 
            RowBox[{"\[Rho]", "->", 
             RowBox[{"0.0", "+", 
              RowBox[{"j", "*", ".1"}]}]}], "}"}]}], ";", 
          RowBox[{"BirthPars", "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               SubscriptBox["b", "w"], "->", 
               RowBox[{"Camels", "*", 
                SubscriptBox["\[Mu]", "w"]}]}], ",", 
              RowBox[{
               SubscriptBox["b", "x"], "->", 
               RowBox[{
                FractionBox[
                 RowBox[{"Nherd", "-", "Camels"}], "2"], "*", 
                SubscriptBox["\[Mu]", "x"]}]}], ",", 
              RowBox[{
               SubscriptBox["b", "y"], "->", 
               RowBox[{
                FractionBox[
                 RowBox[{"Nherd", "-", "Camels"}], "4"], "*", 
                SubscriptBox["\[Mu]", "y"]}]}], ",", 
              RowBox[{
               SubscriptBox["b", "z"], "->", 
               RowBox[{
                FractionBox[
                 RowBox[{"Nherd", "-", "Camels"}], "4"], "*", 
                SubscriptBox["\[Mu]", "z"]}]}]}], "}"}], "/.", "SimPars"}]}], 
          ";", 
          RowBox[{"NumSol", "=", 
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"SSEq", "/.", 
                 RowBox[{
                  SubscriptBox["n", "t"], "->", "Nherd"}]}], "/.", 
                "SimPars"}], "/.", "RhoRep"}], "/.", "BirthPars"}], ",", 
             "AllVar", ",", "NonNegativeReals", ",", 
             RowBox[{"Method", "->", "\"\<Monodromy\>\""}]}], "]"}]}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "NumSol", "]"}], "==", "0"}], ",", 
            RowBox[{"NumSol", "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   SubscriptBox["s", "w"], "[", "t", "]"}], "\[Rule]", 
                  FractionBox[
                   SubscriptBox["b", "w"], 
                   SubscriptBox["\[Mu]", "w"]]}], "/.", "SimPars"}], "/.", 
                "BirthPars"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   SubscriptBox["s", "x"], "[", "t", "]"}], "\[Rule]", 
                  FractionBox[
                   SubscriptBox["b", "x"], 
                   SubscriptBox["\[Mu]", "x"]]}], "/.", "SimPars"}], "/.", 
                "BirthPars"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   SubscriptBox["s", "y"], "[", "t", "]"}], "\[Rule]", 
                  FractionBox[
                   SubscriptBox["b", "y"], 
                   SubscriptBox["\[Mu]", "y"]]}], "/.", "SimPars"}], "/.", 
                "BirthPars"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   SubscriptBox["s", "z"], "[", "t", "]"}], "\[Rule]", 
                  FractionBox[
                   SubscriptBox["b", "z"], 
                   SubscriptBox["\[Mu]", "z"]]}], "/.", "SimPars"}], "/.", 
                "BirthPars"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["\[Iota]", "w"], "[", "t", "]"}], "\[Rule]", 
                "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["\[Iota]", "x"], "[", "t", "]"}], "\[Rule]", 
                "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["\[Iota]", "y"], "[", "t", "]"}], "\[Rule]", 
                "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["\[Iota]", "z"], "[", "t", "]"}], "\[Rule]", 
                "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["r", "w"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["r", "x"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["r", "y"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["r", "z"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["q", "w"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["q", "x"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["q", "y"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{
                 SubscriptBox["q", "z"], "[", "t", "]"}], "\[Rule]", "0"}], ",", 
               RowBox[{
                RowBox[{"B", "[", "t", "]"}], "\[Rule]", "0"}]}], "}"}]}], ",", 
            RowBox[{"NumSol", "=", 
             RowBox[{"NumSol", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
          RowBox[{"LS", "=", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  FractionBox[
                   SubscriptBox["b", "w"], 
                   SubscriptBox["\[Mu]", "w"]], 
                  RowBox[{
                   FractionBox[
                    SubscriptBox["b", "w"], 
                    SubscriptBox["\[Mu]", "w"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "x"], 
                    SubscriptBox["\[Mu]", "x"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "y"], 
                    SubscriptBox["\[Mu]", "y"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "z"], 
                    SubscriptBox["\[Mu]", "z"]]}]], 
                 FractionBox["1", 
                  SubscriptBox["\[Mu]", "w"]]}], "+", 
                RowBox[{
                 FractionBox[
                  FractionBox[
                   SubscriptBox["b", "x"], 
                   SubscriptBox["\[Mu]", "x"]], 
                  RowBox[{
                   FractionBox[
                    SubscriptBox["b", "w"], 
                    SubscriptBox["\[Mu]", "w"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "x"], 
                    SubscriptBox["\[Mu]", "x"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "y"], 
                    SubscriptBox["\[Mu]", "y"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "z"], 
                    SubscriptBox["\[Mu]", "z"]]}]], 
                 FractionBox["1", 
                  SubscriptBox["\[Mu]", "x"]]}], "+", 
                RowBox[{
                 FractionBox[
                  FractionBox[
                   SubscriptBox["b", "y"], 
                   SubscriptBox["\[Mu]", "y"]], 
                  RowBox[{
                   FractionBox[
                    SubscriptBox["b", "w"], 
                    SubscriptBox["\[Mu]", "w"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "x"], 
                    SubscriptBox["\[Mu]", "x"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "y"], 
                    SubscriptBox["\[Mu]", "y"]], "+", 
                   FractionBox[
                    SubscriptBox["b", "z"], 
                    SubscriptBox["\[Mu]", "z"]]}]], 
                 FractionBox["1", 
                  SubscriptBox["\[Mu]", "y"]]}], "+", 
                RowBox[{
                 FractionBox[
                  FractionBox[
                   SubscriptBox["b", "z"], 
                   SubscriptBox["\[Mu]", "z"]], 

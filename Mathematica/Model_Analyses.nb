Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], ",", 
   RowBox[{
    RowBox[{"VillagePreds", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<County\>\"", ",", "\"\<Village\>\"", ",", "\"\<SPCamT\>\"",
         ",", "\"\<SPCowT\>\"", ",", "\"\<SPSheepT\>\"", 
        ",", "\"\<SPGoatT\>\"", ",", "\"\<SPCamP\>\"", ",", "\"\<SPCowP\>\"", 
        ",", "\"\<SPSheepP\>\"", ",", "\"\<SPGoatP\>\"", ",", "\"\<ELife\>\"",
         ",", "\"\<FOI\>\"", ",", "\"\<TrueFOI\>\""}], "}"}], "}"}]}], ";", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "2"}], ",", 
      RowBox[{"j", "<=", 
       RowBox[{"Length", "[", "ToSim", "]"}]}], ",", 
      RowBox[{"j", "++"}], ",", 
      RowBox[{
       RowBox[{"Parms", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SubscriptBox["b", "w"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "3"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "x"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "4"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "y"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "5"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "z"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "6"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "w"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "7"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "x"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 

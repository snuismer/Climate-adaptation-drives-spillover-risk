Cell[BoxData[
 RowBox[{
  RowBox[{"SpillForceFD", "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       SubscriptBox["\[Iota]", "w"], "[", "t", "]"}], "+", 
      RowBox[{
       SubscriptBox["\[Iota]", "x"], "[", "t", "]"}], "+", 
      RowBox[{
       SubscriptBox["\[Iota]", "y"], "[", "t", "]"}], "+", 
      RowBox[{
       SubscriptBox["\[Iota]", "z"], "[", "t", "]"}]}], "PopSize"], "+", 
    RowBox[{"\[Rho]", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["r", "w"], "[", "t", "]"}], "+", 
        RowBox[{
         SubscriptBox["r", "x"], "[", "t", "]"}], "+", 
        RowBox[{
         SubscriptBox["r", "y"], "[", "t", "]"}], "+", 
        RowBox[{
         SubscriptBox["r", "z"], "[", "t", "]"}], "+", 
        RowBox[{
         SubscriptBox["q", "w"], "[", "t", "]"}], "+", 
        RowBox[{
         SubscriptBox["q", "x"], "[", "t", "]"}], "+", 
        RowBox[{
         SubscriptBox["q", "y"], "[", "t", "]"}], "+", 
        RowBox[{
         SubscriptBox["q", "z"], "[", "t", "]"}]}], ")"}], "PopSize"]}]}]}], 
  ";"}]], "Input",

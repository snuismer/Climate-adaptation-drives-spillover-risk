Cell["\<\
Calculate the expected mixed-herd lifespan as a weighted average:\
\>", "Text",
 CellChangeTimes->{{3.9685011655801373`*^9, 3.9685011835708437`*^9}, 
   3.970779463775775*^9},ExpressionUUID->"16abcdec-1cb5-489e-9a2d-\
487db7533e76"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Lifespans", "=", 
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "5"}], "]"}], "]"}], 
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]], "LCam"}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "4"}], "]"}], "]"}], 
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]], "LCow"}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "7"}], "]"}], "]"}], 
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]], "LSheep"}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "6"}], "]"}], "]"}], 
         RowBox[{"VD", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]], "LGoat"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", 
        RowBox[{"Length", "[", "VD", "]"}]}], "}"}]}], "]"}], "/.", "RepL"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.96601620401332*^9, 3.9660163350502453`*^9}, {

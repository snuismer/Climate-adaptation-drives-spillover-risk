Cell[CellGroupData[{

Cell["\<\
Next, simulate the scenario where acute infection lasts 2 years and \
antibodies last for 5 years\
\>", "Subsubsection",
 CellChangeTimes->{{3.966018239800565*^9, 3.9660182428566723`*^9}, {
   3.968504835749131*^9, 3.968504861663438*^9}, 3.9685265141800947`*^9, {

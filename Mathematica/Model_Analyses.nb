   3.9654780404216413`*^9}, 3.965478138977968*^9, 3.9654786188329983`*^9, 
   3.965479497038636*^9, 3.965479796287468*^9, {3.965482917888102*^9, 
   3.9654829309092073`*^9}, {3.9654829792194357`*^9, 3.965482987919857*^9}, {

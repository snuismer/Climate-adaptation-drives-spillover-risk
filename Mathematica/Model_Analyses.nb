                  RowBox[{"VD", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "15"}], "]"}], "]"}], "/", 
                  RowBox[{"VD", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "11"}], "]"}], "]"}]}], "]"}]}], "}"}], 
              ",", 
              RowBox[{
               RowBox[{"SeroPrevIndiKaj", "/.", "ThisSol"}], "/.", "Parms"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"N", "[", 
                RowBox[{"Lifespans", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "-", "1"}], "]"}], "]"}], "]"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"SpillForceTotalKaj", "/.", "ThisSol"}], "/.", 
                "Parms"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"VD", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "31"}], "]"}], "]"}], "}"}]}], "]"}]}], 
           "]"}]}], ",", 
         RowBox[{"VillagePreds", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"VillagePreds", ",", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ToSim", "[", 

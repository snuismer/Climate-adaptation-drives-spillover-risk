974ff0d64dd1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SSE", "=", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"kkaj", "*", 
         RowBox[{"VillagePreds", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "12"}], "]"}], "]"}]}], "-", 
        RowBox[{"VillagePreds", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "13"}], "]"}], "]"}]}], ")"}], "2"], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "2", ",", "9"}], "}"}]}], "]"}], "+", 
   RowBox[{"Sum", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"kmars", "*", 
         RowBox[{"VillagePreds", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "12"}], "]"}], "]"}]}], "-", 
        RowBox[{"VillagePreds", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "13"}], "]"}], "]"}]}], ")"}], "2"], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "10", ",", "16"}], "}"}]}], "]"}]}]}]], "Input",

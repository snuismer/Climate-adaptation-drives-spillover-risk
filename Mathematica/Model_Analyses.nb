Cell[BoxData[
 RowBox[{
  RowBox[{"FitSpillModel", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "11"}], "]"}], "]"}], ",", 
          RowBox[{"kkaj", "*", 
           RowBox[{"VillagePreds", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "12"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", "9"}], "}"}]}], "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "11"}], "]"}], "]"}], ",", 
          RowBox[{"kmars", "*", 
           RowBox[{"VillagePreds", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "12"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "10", ",", "16"}], "}"}]}], "]"}]}], "]"}], "/.", 
    RowBox[{"SpillCos", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]], "Input",

Cell["\<\
Generate quantitative predictions for FOI using the estimated values of the \
spillover coefficients:\
\>", "Text",
 CellChangeTimes->{{3.9711738240892572`*^9, 
  3.971173841482212*^9}},ExpressionUUID->"35f39331-633b-41de-a64e-\
41aa95b43cf9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FitSpillModel", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "11"}], "]"}], "]"}], ",", 
          RowBox[{"kkaj", "*", 
           RowBox[{"VillagePreds", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "12"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", "9"}], "}"}]}], "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "11"}], "]"}], "]"}], ",", 
          RowBox[{"kmars", "*", 
           RowBox[{"VillagePreds", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "12"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "10", ",", "16"}], "}"}]}], "]"}]}], "]"}], "/.", 
    RowBox[{"SpillCos", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.968583658121915*^9, 3.968583795405637*^9}, {
   3.968583856074535*^9, 3.9685839270174026`*^9}, 3.9709185546448917`*^9},
 CellLabel->

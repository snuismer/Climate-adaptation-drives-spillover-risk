Cell["\<\
Estimate spillover coefficients by minimizing the summed square error between \
predicted and observed FOI:\
\>", "Text",
 CellChangeTimes->{{3.968583205488636*^9, 3.96858325338269*^9}, 
   3.971173844117774*^9, {3.971539061506901*^9, 
   3.9715390625945683`*^9}},ExpressionUUID->"db078f09-5371-4b9f-9a9a-\
488f8f6cd22e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SSE", "=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"kkaj", "*", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "12"}], "]"}], "]"}]}], "-", 
         RowBox[{"VillagePreds", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "13"}], "]"}], "]"}]}], ")"}], "2"], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", "9"}], "}"}]}], "]"}], "+", 
    RowBox[{"Sum", "[", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"kmars", "*", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "12"}], "]"}], "]"}]}], "-", 
         RowBox[{"VillagePreds", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "13"}], "]"}], "]"}]}], ")"}], "2"], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "10", ",", "16"}], "}"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.968583313843657*^9, 3.9685833346845512`*^9}, {
   3.968583370109879*^9, 3.9685834829508047`*^9}, {3.968583578608169*^9, 
   3.9685835814896727`*^9}, 3.970918537079447*^9, 3.9715390656440277`*^9},
 CellLabel->
  "In[275]:=",ExpressionUUID->"4f350851-25c8-47c3-9479-abf8951089df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SpillCos", "=", 
  RowBox[{"NMinimize", "[", 
   RowBox[{"SSE", ",", 
    RowBox[{"{", 
     RowBox[{"kkaj", ",", "kmars"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9685835128585377`*^9, 3.968583539602009*^9}, {
   3.968583603005905*^9, 3.9685836243074102`*^9}, 3.9715390685795307`*^9},
 CellLabel->
  "In[276]:=",ExpressionUUID->"8319db3d-a40d-41af-a4e8-7af0cb3a5c99"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.00005221861815173551`", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"kkaj", "\[Rule]", "0.02826750347138386`"}], ",", 
     RowBox[{"kmars", "\[Rule]", "0.07509654964387633`"}]}], "}"}]}], 
  "}"}]], "Output",

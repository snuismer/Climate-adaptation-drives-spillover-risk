           SubscriptBox["\[Mu]", "y"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "9"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "z"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "10"}], "]"}], "]"}]}], ",", 
          RowBox[{"\[Beta]", "->", 
           RowBox[{"MLDGHO15HAT", "[", 
            RowBox[{"[", "6", "]"}], "]"}]}], ",", 
          RowBox[{"\[ScriptCapitalA]", "\[Rule]", 
           RowBox[{"MLDGHO15HAT", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}], ",", 
          RowBox[{"\[Rho]", "->", 
           RowBox[{"MLDGHO15HAT", "[", 
            RowBox[{"[", "7", "]"}], "]"}]}], ",", 
          RowBox[{"\[Gamma]", "->", 
           FractionBox["1", 
            RowBox[{"0.5", "*", "365"}]]}], ",", 
          RowBox[{"\[Omega]", "->", 
           FractionBox["1", 
            RowBox[{"15.0", "*", "365"}]]}], ",", 
          RowBox[{"kmars", "->", "1"}], ",", 
          RowBox[{"kkaj", "->", "1"}]}], "}"}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToSim", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "1"}], "]"}], "]"}], "==", "\"\<Kajiado\>\""}], 
         ",", 
         RowBox[{"ThisSol", "=", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{"QSSEQKaj", "/.", "Parms"}], ",", "QSSEQVarKaj", ",", 
            "PositiveReals", ",", 
            RowBox[{"Method", "->", "\"\<Monodromy\>\""}]}], "]"}]}], ",", 
         RowBox[{"ThisSol", "=", 
          RowBox[{"NSolve", "[", 
           RowBox[{
            RowBox[{"QSSEQMars", "/.", "Parms"}], ",", "QSSEQVarMars", ",", 
            "PositiveReals", ",", 
            RowBox[{"Method", "->", "\"\<Monodromy\>\""}]}], "]"}]}]}], "]"}],
        ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "ThisSol", "]"}], ">", "1"}], ",", 
         RowBox[{"ThisSol", "=", 
          RowBox[{"ThisSol", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"ThisSol", "=", 
          RowBox[{"ThisSol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToSim", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "1"}], "]"}], "]"}], "==", "\"\<Kajiado\>\""}], 

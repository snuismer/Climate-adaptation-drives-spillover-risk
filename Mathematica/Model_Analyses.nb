Cell["\<\
Generate quantitative predictions for FOI using the estimated values of the \
spillover coefficients:\
\>", "Text",
 CellChangeTimes->{{3.9711738240892572`*^9, 
  3.971173841482212*^9}},ExpressionUUID->"d4fcc828-b59d-4219-9602-\
b0e0cc472121"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FitSpillModel", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "11"}], "]"}], "]"}], ",", 
          RowBox[{"kkaj", "*", 
           RowBox[{"VillagePreds", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "12"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", "9"}], "}"}]}], "]"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
          RowBox[{"VillagePreds", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "11"}], "]"}], "]"}], ",", 
          RowBox[{"kmars", "*", 
           RowBox[{"VillagePreds", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "12"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "10", ",", "16"}], "}"}]}], "]"}]}], "]"}], "/.", 
    RowBox[{"SpillCos", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]], "Input",

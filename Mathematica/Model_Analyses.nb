   3.9711740480960197`*^9}},ExpressionUUID->"b7a9965a-56d9-47cd-b628-\
d9fed98be464"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], ",", 
   RowBox[{
    RowBox[{"VillagePreds", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<County\>\"", ",", "\"\<Village\>\"", ",", "\"\<SPCamT\>\"",
         ",", "\"\<SPCowT\>\"", ",", "\"\<SPSheepT\>\"", 
        ",", "\"\<SPGoatT\>\"", ",", "\"\<SPCamP\>\"", ",", "\"\<SPCowP\>\"", 
        ",", "\"\<SPSheepP\>\"", ",", "\"\<SPGoatP\>\"", ",", "\"\<ELife\>\"",
         ",", "\"\<FOI\>\"", ",", "\"\<TrueFOI\>\""}], "}"}], "}"}]}], ";", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "2"}], ",", 
      RowBox[{"j", "<=", 
       RowBox[{"Length", "[", "ToSim", "]"}]}], ",", 
      RowBox[{"j", "++"}], ",", 
      RowBox[{
       RowBox[{"Parms", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SubscriptBox["b", "w"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "3"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "x"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "4"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "y"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "5"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "z"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "6"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "w"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "7"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "x"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "8"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "y"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "9"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "z"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "10"}], "]"}], "]"}]}], ",", 
          RowBox[{"\[Beta]", "->", 
           RowBox[{"MLDG2O5HAT", "[", 
            RowBox[{"[", "6", "]"}], "]"}]}], ",", 
          RowBox[{"\[ScriptCapitalA]", "\[Rule]", 
           RowBox[{"MLDG2O5HAT", "[", 
            RowBox[{"[", "5", "]"}], "]"}]}], ",", 
          RowBox[{"\[Rho]", "->", 
           RowBox[{"MLDG2O5HAT", "[", 
            RowBox[{"[", "7", "]"}], "]"}]}], ",", 
          RowBox[{"\[Gamma]", "->", 
           FractionBox["1", 
            RowBox[{"2", "*", "365"}]]}], ",", 
          RowBox[{"\[Omega]", "->", 
           FractionBox["1", 
            RowBox[{"5", "*", "365"}]]}], ",", 
          RowBox[{"kmars", "->", "1"}], ",", 
          RowBox[{"kkaj", "->", "1"}]}], "}"}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToSim", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "1"}], "]"}], "]"}], "==", "\"\<Kajiado\>\""}], 
         ",", 
         RowBox[{"ThisSol", "=", 
          RowBox[{
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{"QSSEQKaj", "/.", "Parms"}], ",", "QSSEQVarKaj", ",", 
             "PositiveReals", ",", 
             RowBox[{"Method", "->", "\"\<Monodromy\>\""}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"ThisSol", "=", 
          RowBox[{
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{"QSSEQMars", "/.", "Parms"}], ",", "QSSEQVarMars", ",", 
             "PositiveReals", ",", 
             RowBox[{"Method", "->", "\"\<Monodromy\>\""}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToSim", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "1"}], "]"}], "]"}], "==", "\"\<Kajiado\>\""}], 
         ",", 
         RowBox[{"VillagePreds", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"VillagePreds", ",", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ToSim", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", "1"}], "]"}], "]"}], ",", 

              ",", 
              RowBox[{"{", 
               RowBox[{"N", "[", 
                RowBox[{"Lifespans", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "-", "1"}], "]"}], "]"}], "]"}], "}"}], ",", 
              RowBox[{"{", 

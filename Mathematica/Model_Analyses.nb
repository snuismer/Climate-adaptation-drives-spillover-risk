                    RowBox[{"j", ",", "16"}], "]"}], "]"}], "/", 
                  RowBox[{"VD", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "12"}], "]"}], "]"}]}], "]"}], ",", 
                RowBox[{"N", "[", 

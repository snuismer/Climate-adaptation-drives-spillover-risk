Cell[CellGroupData[{

Cell["\<\
Simulate scenarios using the model and estimated model parameters\
\>", "Subsection",
 CellChangeTimes->{{3.965988872253687*^9, 3.965988875248939*^9}, {
  3.966018322970622*^9, 3.966018323868341*^9}, {3.970918263118361*^9, 
  3.970918296287941*^9}},ExpressionUUID->"7dc90dcd-edb9-4cde-b9ea-\
7a965692f289"],

Cell[CellGroupData[{

Cell["\<\
First, simulate the scenario where acute infection lasts 2 years and \
antibodies 15 years\
\>", "Subsubsection",
 CellChangeTimes->{{3.966018239800565*^9, 3.9660182428566723`*^9}, {
  3.968504835749131*^9, 3.968504861663438*^9}, {3.9709183009696827`*^9, 
  3.970918304499653*^9}},ExpressionUUID->"838c63d7-3142-4be9-9e76-\
50c53cd6f9e9"],

Cell[TextData[{
 "In the column headers below, T indicates observed seroprevalence and P \
indicates predicted seroprevalence. FOI is the force of infection into the \
human population predicted by the simulation and TrueFOI is the force of \
infection in the human population estimated independently using age-structure \
human seroprevalence data. Note that the age-structured human seroprevalence \
data was ",
 StyleBox["NOT ",
  FontSlant->"Italic"],
 "used to ",
 "estimate model parameters. The spillover coefficients k are set to unity \
here and estimated later."
}], "Text",
 CellChangeTimes->{{3.9685061623676567`*^9, 3.9685061975642138`*^9}, {
  3.970918339716546*^9, 3.970918440597005*^9}, {3.971172421311425*^9, 
  3.971172424447879*^9}, {3.971172722223957*^9, 3.971172742913261*^9}, {
  3.971541412653039*^9, 
  3.971541418276969*^9}},ExpressionUUID->"5bcd9140-8791-4635-80aa-\
25fe9707de72"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], ",", 
   RowBox[{
    RowBox[{"VillagePreds", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\"\<County\>\"", ",", "\"\<Village\>\"", ",", "\"\<SPCamT\>\"",
         ",", "\"\<SPCowT\>\"", ",", "\"\<SPSheepT\>\"", 
        ",", "\"\<SPGoatT\>\"", ",", "\"\<SPCamP\>\"", ",", "\"\<SPCowP\>\"", 
        ",", "\"\<SPSheepP\>\"", ",", "\"\<SPGoatP\>\"", ",", "\"\<ELife\>\"",
         ",", "\"\<FOI\>\"", ",", "\"\<TrueFOI\>\""}], "}"}], "}"}]}], ";", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "2"}], ",", 
      RowBox[{"j", "<=", 
       RowBox[{"Length", "[", "ToSim", "]"}]}], ",", 
      RowBox[{"j", "++"}], ",", 
      RowBox[{
       RowBox[{"Parms", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SubscriptBox["b", "w"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "3"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "x"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "4"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "y"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "5"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["b", "z"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "6"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "w"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "7"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "x"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "8"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "y"], "->", 
           RowBox[{"ToSim", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "9"}], "]"}], "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[Mu]", "z"], "->", 
